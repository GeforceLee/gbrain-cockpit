{
  "name": "gbrain-cockpit",
  "private": true,
  "workspaces": [
    "server",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "cd server && bun dev & cd web && bun dev",
    "build": "cd web && bun run build",
    "compile:darwin": "bun build --compile server/src/index.ts --outfile dist-bin/cockpit-darwin-arm64",
    "compile:linux": "bun build --compile --target=bun-linux-x64 server/src/index.ts --outfile dist-bin/cockpit-linux-x64",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p server && tsc --noEmit -p web",
    "test": "bun test",
    "check:locales": "bun scripts/check-locales.ts",
    "audit": "bun audit"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
