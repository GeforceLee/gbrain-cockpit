# gbrain-cockpit configuration (copy to .env and fill in; .env is gitignored)
# Full reference: README.md → "Configuration".

# --- cockpit itself ---
# Listen address. Keep 127.0.0.1 unless you front cockpit with a reverse proxy
# or an encrypted tunnel (Tailscale Serve etc.) — "LAN" is not a trust boundary.
COCKPIT_BIND=127.0.0.1
COCKPIT_PORT=8787
# Required (fail-closed): startup refuses to continue without it.
COCKPIT_TOKEN=
# Optional management tier (0.4.0): unlocks management writes (source grant
# widening). Unset ⇒ management writes answer 403 in-band and the UI falls
# back to copy-commands — single-token installs behave exactly as before.
# Must differ from COCKPIT_TOKEN (startup refuses identical values). The
# browser asks for it per action (step-up paste); it is never persisted.
COCKPIT_ADMIN_TOKEN=
# Extra allowed Host header values (comma-separated), for when cockpit sits
# behind a reverse proxy or tunnel that rewrites Host (DNS-rebinding defense).
# Entries without a port get COCKPIT_PORT appended, e.g. "cockpit.example.com".
COCKPIT_ALLOWED_HOSTS=
# Static web root override (compiled-binary / single-directory deployments).
# Leave unset for repo checkouts — the server then serves web/dist if present.
COCKPIT_DIST_DIR=

# --- multiple brains (optional; unset = single-instance via GBRAIN_* below) ---
# Point at a profiles JSON to switch between gbrain deployments in the top bar.
# The file is a SECRETS artifact (it holds gbrain credentials): keep it 0600 and
# outside the repo — the conventional names brains.json / cockpit-profiles.json
# are gitignored. Per profile: id (kebab), name, mcpUrl, mcpToken | mcpCredentials
# (an OAuth `gbrain mcp grant --credentials-out` handoff; the driver renews the
# access token itself), optional pgReadonlyDsn, optional cliBin (bare name for
# wrapper brains like gbrain-bip, or an absolute path), optional takesHolders.
# Wrappers should strip GBRAIN_BRAIN_ID / GBRAIN_SOURCE; see
# docs/architecture.md → "Multi-brain profiles".
#
# brains.json example:
# [
#   { "id": "atlas", "name": "atlas-brain",
#     "mcpUrl": "http://127.0.0.1:3131/mcp", "mcpToken": "…",
#     "pgReadonlyDsn": "postgresql://cockpit_ro:…@127.0.0.1:5432/gbrain",
#     "cliBin": "gbrain" },
#   { "id": "bip", "name": "bip-brain",
#     "mcpUrl": "http://127.0.0.1:3132/mcp",
#     "mcpCredentials": "/etc/gbrain-cockpit/bip-credentials.json",
#     "cliBin": "gbrain-bip",
#     "pgReadonlyDsn": "postgresql://cockpit_ro:…@127.0.0.1:5432/bip",
#     "gbrainBin": "/home/you/.bun/bin/gbrain",
#     "gbrainHome": "/home/you/gbrain-bip" }
# ]
COCKPIT_PROFILES_FILE=

# --- gbrain MCP endpoint (primary channel; single-instance mode) ---
GBRAIN_MCP_URL=http://127.0.0.1:3131/mcp
# Required (fail-closed). Mint on the brain host:
#   gbrain auth create cockpit-ui --scopes read,write,memory_confirm --takes-holders <all-holders>
# NOTE: takes holders default to `world` (fail-closed) — list every holder or the
# takes queues will look empty in the UI.
GBRAIN_MCP_TOKEN=
# The full holder list used when minting the token; checked at startup.
GBRAIN_TAKES_HOLDERS=

# --- gbrain CLI (narrow adjudication channel, brain host only) ---
# Leave empty to auto-discover via `which gbrain`.
GBRAIN_BIN=

# --- read-only graph bypass (optional; ignored on PGLite engines) ---
# Must be a dedicated read-only account. cockpit never writes through it, and
# the account itself must be denied writes at the database level. Mint it on
# the brain host (same philosophy as token minting — the owner runs it).
# Live-probed on gbrain 0.60.558 (2026-11-04):
#   - the brain lives in the `postgres` DATABASE (gbrain config database_url),
#     tables public.pages / public.links
#   - take_proposals (Inbox takes queue) reads cross-source through the same
#     account — the CLI's `takes propose` list is scoped to ONE source per run
#     (resolveSourceId → 'default' with no GBRAIN_SOURCE), so multi-source
#     brains need this table granted to see non-default sources' proposals
#   - both tables ENABLE row level security with zero policies → a fresh role
#     silently sees ZERO rows; BYPASSRLS on our role restores visibility
#     without touching gbrain's tables or policies (SELECT is granted on
#     pages/links only, so that is all the role can ever read)
#   psql -h 127.0.0.1 -U postgres -d postgres
#     CREATE ROLE cockpit_ro LOGIN PASSWORD '<choose-a-secret>';
#     GRANT USAGE ON SCHEMA public TO cockpit_ro;
#     GRANT SELECT ON public.pages, public.links, public.take_proposals TO cockpit_ro;
#     ALTER ROLE cockpit_ro BYPASSRLS;
# Then point the DSN at the brain host's Postgres, e.g.:
#   postgresql://cockpit_ro:<secret>@<brain-host>:5432/postgres
# Leave unset on PGLite engines — Nebula and the takes queue then report the
# channel as down.
# Multi-source brains: also declare the direct-call pair per profile so takes
# adjudication carries GBRAIN_SOURCE (see docs/architecture.md):
#   "gbrainBin": "/home/you/.bun/bin/gbrain",  # the REAL binary, not a wrapper
#   "gbrainHome": "/home/you/gbrain-bip"       # holds .gbrain/config.json
PG_READONLY_DSN=
